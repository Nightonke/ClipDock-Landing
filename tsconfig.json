{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": "./src",
		"paths": {
			"@/content/*": [
				"content/*"
			],
			"@/components/*": [
				"components/*"
			],
			"@/interactive/*": [
				"components/interactive/*"
			],
			"@/ui/*": [
				"components/ui/*"
			],
			"@/sections/*": [
				"components/sections/*"
			],
			"@/styles/*": [
				"styles/*"
			],
			"@/utils/*": [
				"utils/*"
			],
			"@/i18n/*": [
				"i18n/*"
			],
			"@layouts/*": [
				"layouts/*"
			],
			"@config/*": [
				"config/*"
			],
			"@/types/*": [
				"types/*"
			],
			"@/lib/*": [
				"lib/*"
			]
		}
	}
}
