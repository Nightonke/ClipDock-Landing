---
// Use the same frame as the preframed tutorial assets, without altering screenshots.
import phoneShell from "../assets/iphone-orange.png";
---
<span class="orange-phone-frame">
	<span class="orange-phone-screen"><slot /></span>
	<img class="orange-phone-shell" src={phoneShell.src} width={phoneShell.width} height={phoneShell.height} alt="" aria-hidden="true" loading="lazy" decoding="async" />
</span>
<style>
	.orange-phone-frame { display: block; position: relative; width: 100%; aspect-ratio: 1319 / 2748; }
	/* Screen opening measured from the original frame's transparent area. */
	.orange-phone-screen { position: absolute; left: calc(57 / 1319 * 100%); top: calc(63 / 2748 * 100%); width: calc(1206 / 1319 * 100%); height: calc(2622 / 2748 * 100%); overflow: hidden; border-radius: 13% / 6%; background: #000; }
	.orange-phone-screen :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; border-radius: 0; }
	.orange-phone-frame > .orange-phone-shell { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 0; pointer-events: none; }
</style>
