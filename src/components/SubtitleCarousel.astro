---
const slides = [
 { file: "paste-link", title: "粘贴 YouTube 视频链接" },
 { file: "extracting", title: "等待字幕提取完成" },
 { file: "select-tracks", title: "选择需要的字幕语言" },
 { file: "select-format", title: "选择字幕文件格式" },
 { file: "export", title: "保存到文件或分享" },
];
---
<div class="subtitle-carousel" role="region" aria-roledescription="轮播" aria-label="YouTube 字幕提取操作步骤">
 <div class="subtitle-slides">
  {slides.map((slide, index) => (
   <img src={`/assets/tutorials/youtube-subtitles/${slide.file}.webp`} alt={slide.title} width="1320" height="2868" loading="lazy" decoding="async" hidden={index !== 0} />
  ))}
 </div>
 <div class="subtitle-progress" role="group" aria-label="选择步骤">
  {slides.map((slide, index) => (
   <button type="button" class="subtitle-segment" aria-label={`第 ${index + 1} 张：${slide.title}`} aria-current={index === 0 ? "step" : undefined}>
    <span class="segment-track"><span class="segment-fill"></span></span>
   </button>
  ))}
 </div>
 <div class="subtitle-footer">
  <p class="subtitle-caption">1 / 5 · {slides[0].title}</p>
  <button type="button" class="subtitle-toggle" aria-label="暂停自动轮播">暂停</button>
 </div>
</div>
<style>
 .subtitle-carousel { width: 100%; }
 .subtitle-slides { aspect-ratio: 1320 / 2868; overflow: hidden; border: 2px solid var(--ink); border-radius: calc(var(--radius-lg) - 18px); background: #000; }
 .subtitle-slides img { display: block; width: 100%; height: auto; }
 .subtitle-slides img[hidden] { display: none; }
 .subtitle-progress { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; margin-top: 4px; }
 .subtitle-segment { display: flex; align-items: center; min-width: 0; height: 32px; padding: 0; border: 0; background: transparent; cursor: pointer; }
 .segment-track { display: block; width: 100%; height: 3px; overflow: hidden; border-radius: 99px; background: rgba(23,25,22,.18); }
 .segment-fill { display: block; width: 100%; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; }
 .subtitle-footer { display: flex; align-items: baseline; gap: 8px; justify-content: space-between; }
 .subtitle-caption { margin: 0; color: var(--ink); font-size: .8rem; line-height: 1.6; }
 .subtitle-toggle { flex-shrink: 0; border: 0; padding: 4px 0 4px 4px; background: transparent; color: var(--ink); font-size: .75rem; cursor: pointer; }
 button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 3px; }
</style>
<script>
 document.querySelectorAll<HTMLElement>(".subtitle-carousel").forEach((carousel) => {
  const slides = [...carousel.querySelectorAll<HTMLImageElement>(".subtitle-slides img")];
  const buttons = [...carousel.querySelectorAll<HTMLButtonElement>(".subtitle-segment")];
  const fills = [...carousel.querySelectorAll<HTMLElement>(".segment-fill")];
  const caption = carousel.querySelector<HTMLElement>(".subtitle-caption")!;
  const toggle = carousel.querySelector<HTMLButtonElement>(".subtitle-toggle")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const duration = 4000;
  let current = 0;
  let elapsed = 0;
  let last = 0;
  let frame = 0;
  let visible = false;
  let paused = reducedMotion.matches;
  const paint = () => fills.forEach((fill, index) => {
   fill.style.transform = `scaleX(${index < current ? 1 : index === current ? elapsed / duration : 0})`;
  });
  const select = (index: number) => {
   current = index;
   elapsed = 0;
   slides.forEach((slide, i) => { slide.hidden = i !== current; });
   buttons.forEach((button, i) => {
    if (i === current) button.setAttribute("aria-current", "step");
    else button.removeAttribute("aria-current");
   });
   caption.textContent = `${current + 1} / ${slides.length} · ${slides[current].alt}`;
   paint();
  };
  const tick = (now: number) => {
   if (last) elapsed += now - last;
   last = now;
   if (elapsed >= duration) select((current + 1) % slides.length);
   paint();
   frame = requestAnimationFrame(tick);
  };
  const sync = () => {
   cancelAnimationFrame(frame);
   last = 0;
   toggle.textContent = paused ? "播放" : "暂停";
   toggle.setAttribute("aria-label", paused ? "播放自动轮播" : "暂停自动轮播");
   if (visible && !paused && !document.hidden) frame = requestAnimationFrame(tick);
  };
  buttons.forEach((button, index) => button.addEventListener("click", () => { select(index); sync(); }));
  toggle.addEventListener("click", () => { paused = !paused; sync(); });
  document.addEventListener("visibilitychange", sync);
  reducedMotion.addEventListener("change", () => { paused = reducedMotion.matches; sync(); });
  new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { threshold: .25 }).observe(carousel);
  sync();
 });
</script>
