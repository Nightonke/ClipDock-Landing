---
import { appPlatforms, androidPath, androidLegalLocale } from '../../config/platforms';
import { platformCopy } from '../../i18n/platforms';
import { siteUI } from "@/i18n/site-ui";
import { localizedPath, localeMeta, type Locale } from "@/i18n/locales";
import LanguagePicker from "../LanguagePicker.astro";
import type { LanguageLink } from "@/types/content";

interface Props {
 locale?: Locale;
	name: string;
	logo: string;
	tagline: string;
	homeHref: string;
	privacyHref: string;
	termsHref: string;
	storeHref: string;
	privacyLabel: string;
	termsLabel: string;
	getAppLabel: string;
	languageLinks: LanguageLink[];
}

const {
	name,
	logo,
	tagline,
	homeHref,
	privacyHref,
	termsHref,
	storeHref,
	privacyLabel,
	termsLabel,
	getAppLabel,
	languageLinks,
} = Astro.props;
const year = new Date().getFullYear();
const locale = Astro.props.locale ?? (homeHref === "/" ? "en-US" : "zh-Hans");
const ui = siteUI(locale);
const platform = platformCopy[locale];

---

<footer class="site-footer">
	<div class="site-shell footer-grid">
		<a class="footer-brand" href={homeHref}>
			<img src={logo} width="46" height="46" alt="" loading="lazy" />
			<span>
				<strong>{name}</strong>
				<span>{tagline}</span>
			</span>
		</a>

		<div class="footer-meta">
			<nav class="footer-links" aria-label={ui.footerNav}>
				<a href={localizedPath(locale, 'download')}>{getAppLabel}</a>
                <a href={appPlatforms.ios.storeUrl} target="_blank" rel="noopener noreferrer">App Store</a>
                <a href={appPlatforms.android.storeUrl} target="_blank" rel="noopener noreferrer">Google Play</a>
                <a href={androidPath(locale)} hreflang={localeMeta[locale].hrefLang}>{platform.androidDetails}</a>
                <a href={localizedPath(locale, 'privacy')}>iOS · {privacyLabel}</a>
                <a href={localizedPath(locale, 'terms')}>iOS · {termsLabel}</a>
                <a href={androidPath(locale, 'privacy')} hreflang={localeMeta[androidLegalLocale(locale)].hrefLang}>Android · {privacyLabel}{platform.androidLanguage}</a>
                <a href={androidPath(locale, 'terms')} hreflang={localeMeta[androidLegalLocale(locale)].hrefLang}>Android · {termsLabel}{platform.androidLanguage}</a>
                <a href={androidPath(locale, 'delete-account')} hreflang={localeMeta[androidLegalLocale(locale)].hrefLang}>{platform.deletion}{platform.androidLanguage}</a>

			</nav>
			<LanguagePicker languageLinks={languageLinks} placement="footer" />
			<div class="footer-copyright">© 2025–{year} Smith Night</div>
		</div>
	</div>
</footer>
