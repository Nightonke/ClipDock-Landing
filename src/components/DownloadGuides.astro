---
import HeadingText from './HeadingText.astro';
import { getDownloadGuides } from '../content/download-guides';
import { downloadGuideCopy } from '../i18n/download-guides';
import { localizedPath, type Locale } from '../i18n/locales';
interface Props { locale: Locale; showAll?: boolean }
const { locale, showAll = false } = Astro.props;
const copy = downloadGuideCopy[locale];
const guides = getDownloadGuides(locale);
---
<section id="download-guides" class="download-guides" aria-labelledby="download-guides-title">
 <div class="download-guides-heading">
  <div><h2 id="download-guides-title"><HeadingText text={copy.heading} locale={locale} /></h2><p>{copy.intro}</p></div>
  {showAll && <a class="text-link" href={localizedPath(locale, 'articles')}>{copy.browse} <span aria-hidden="true">→</span></a>}
 </div>
 <div class="download-guides-grid">
  {guides.map(article => <a class="download-guide" href={localizedPath(locale, `articles/${article.slug}`)}>
   <span><HeadingText text={article.title} locale={locale} /></span><span aria-hidden="true">↗</span>
  </a>)}
 </div>
</section>
<style>
 .download-guides { padding-block: 40px 48px; scroll-margin-top: 100px; }
 .download-guides-heading { display: flex; align-items: start; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
 h2 { margin: 0; font-family: var(--display); font-size: clamp(1.65rem, 3vw, 2.3rem); line-height: 1.3; letter-spacing: -.035em; text-wrap: balance; }
 p { margin: 12px 0 0; color: var(--ink-soft); line-height: 1.7; }
 .text-link { flex-shrink: 0; margin-top: 6px; }
 .text-link::after { content: none; }
 .download-guides-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
 .download-guide { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-width: 0; padding: 20px; border: 1.5px solid var(--ink); border-radius: 16px; background: var(--paper-strong); font-weight: 750; line-height: 1.6; transition: background 150ms ease; }
 .download-guide:hover { background: var(--blue-soft); }
 .download-guide:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; background: var(--blue-soft); }
 .download-guide > span:first-child { overflow-wrap: anywhere; text-wrap: balance; }
 .download-guide > span:last-child { flex-shrink: 0; font-size: 1.2rem; }
 @media (max-width: 1020px) { .download-guides-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
 @media (max-width: 680px) { .download-guides-heading { flex-direction: column; gap: 12px; } }
 @media (max-width: 430px) { .download-guides-grid { grid-template-columns: 1fr; } }
</style>
