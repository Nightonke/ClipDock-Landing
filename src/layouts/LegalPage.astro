---
import Layout from "@layouts/Layout.astro";
import { commonCopy } from "@/i18n/common";
import { landingContent } from "@/i18n/content";
import { legalContent, type LegalPage } from "@/i18n/legal";
import { androidLegalPath, platformNotices } from "@/i18n/android-legal";
import { getLanguageLinks, localizedPath, localeMeta, type Locale } from "@/i18n/locales";
import { parseMarkdown } from "@/utils/parseMarkdown";

interface Props {
	locale: Locale;
	page: LegalPage;
}

const { locale, page } = Astro.props;
const app = landingContent[locale];
const copy = legalContent[locale];
const document = copy[page];
const homeHref = localizedPath(locale);
const html = await parseMarkdown(document.content);
const platform = platformNotices[locale];
---

<Layout
	title={`${document.title} | ${app.shortName}`}
	description={document.description}
	lang={localeMeta[locale].htmlLang}
	appData={app}
	alternates={getLanguageLinks(locale, page)}
	homeHref={homeHref}
	privacyHref={localizedPath(locale, "privacy")}
	termsHref={localizedPath(locale, "terms")}
	labels={app.labels}
>
	<main id="main-content" class="legal-shell">
		<div class="legal-toolbar">
			<nav class="detail-breadcrumb" aria-label={commonCopy[locale].breadcrumb}>
				<a href={homeHref}>{commonCopy[locale].home}</a>
				<span aria-current="page">{document.title}</span>
			</nav>
			<nav class="legal-languages" aria-label={copy.navigationLabel}>
				{(["privacy", "terms"] as const).map(key => (
					<a href={localizedPath(locale, key)} aria-current={key === page ? "page" : undefined}>
						{copy[key].title}
					</a>
				))}
			</nav>
		</div>
		<article class="prose">
			<h1>{document.title}</h1>
			<aside class="platform-notice" aria-label={platform.title}>
				<strong>{platform.title}</strong>
				<p>{platform.text}</p>
				<div class="platform-links">
					<a href={androidLegalPath(platform.locale, page)} hreflang={localeMeta[platform.locale].hrefLang}>{platform.android}</a>
					<a href={androidLegalPath(platform.locale, "delete-account")} hreflang={localeMeta[platform.locale].hrefLang}>{platform.deletion}</a>
				</div>
			</aside>
			<p class="platform-scope">{platform.ios}</p>
			<p class="legal-date">{copy.effectiveDateLabel} <time datetime={copy.effectiveDate}>{copy.effectiveDateText}</time></p>
			<Fragment set:html={html} />
		</article>
	</main>
</Layout>

<style>
	.legal-shell {
		max-width: 880px;
	}

	.detail-breadcrumb {
		margin: 0;
	}

	.prose {
		max-width: none;
		overflow-wrap: anywhere;
	}

	:global(html[lang="de"]) .prose :global(h1) {
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1.15;
	}

	:global(html[lang="de"]) .prose :global(h2) {
		font-size: clamp(1.5rem, 3vw, 2rem);
	}

	:global(html[lang="de"]) .prose :global(h3) {
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
	}

	.legal-date {
		font-size: 0.9rem;
	}

	.platform-notice { padding: 1.25rem; border: 1px solid #93c5fd; border-radius: 1rem; background: #eff6ff; color: #172554; margin: 1.5rem 0; }
	.platform-notice p { margin: .65rem 0; }
	.platform-links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
	.platform-notice a { color: #1d4ed8; font-weight: 600; }
	.platform-scope { font-weight: 700; }

	.prose :global(h2),
	.prose :global(h3) {
		line-height: 1.35;
	}
</style>
