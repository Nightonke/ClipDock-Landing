---
import HeadingText from "@/components/HeadingText.astro";
import { commonCopy } from "@/i18n/common";
import { mediaUrl } from "@config/media";
import type { LanguageLink } from "@/types/content";
import type { landingContent } from "@/i18n/content";
import { localizedPath } from "@/i18n/locales";
import Layout from "./Layout.astro";
import VideoRecovery from "@/components/VideoRecovery.astro";
import HeroDemos from "@/components/HeroDemos.astro";
import SubtitleCarousel from "@/components/SubtitleCarousel.astro";
import { captionAt } from "@config/demoCaptions";
import { homeContent } from "@/i18n/home";
import type { PublishedLocale } from "@/i18n/locales";
import { hasTutorial } from "@/content/localized-tutorials";

type LandingContent = (typeof landingContent)[keyof typeof landingContent];

interface Props {
	content: LandingContent;
	languageLinks: LanguageLink[];
}

const { content, languageLinks } = Astro.props;
const homeHref = localizedPath(content.locale);
const storeURL = content.storeLinks.apple;

const copy = homeContent[content.locale as PublishedLocale];
const { capabilities, featureSections, tools, faqs, ui } = copy;
const tutorialLink = (slug: string) => hasTutorial(content.locale, slug) ? localizedPath(content.locale, `articles/${slug}`) : undefined;

const siteURL = Astro.site ?? new URL("https://clipdock.video");
const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "MobileApplication",
		name: content.name,
		description: content.metaDescription,
		url: new URL(homeHref, siteURL).href,
		downloadUrl: storeURL,
		operatingSystem: "iOS 15.0 or later, iPadOS 15.0 or later",
		applicationCategory: "UtilitiesApplication",
		softwareVersion: content.version,
		offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
		aggregateRating: {
			"@type": "AggregateRating",
			ratingValue: content.rating.score,
			ratingCount: Number(content.rating.count),
			bestRating: 5,
			worstRating: 1,
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faqs.map((item) => ({
			"@type": "Question",
			name: item.question,
			acceptedAnswer: { "@type": "Answer", text: item.answer },
		})),
	},
];
---

<Layout
	title={content.seoTitle}
	description={content.metaDescription}
	lang={content.htmlLang}
	alternates={languageLinks}
	appData={content}
	homeHref={homeHref}
	privacyHref={localizedPath(content.locale, "privacy")}
	termsHref={localizedPath(content.locale, "terms")}
	labels={content.labels}
	ogImageAlt={ui.ogAlt}
	structuredData={structuredData}
>
	<main id="main-content" class="clipdock-main">
		<section class="cd-hero">
			<div class="site-shell cd-hero-grid">
				<div class="cd-hero-copy">
					<p class="eyebrow">{content.locale === "en-US" ? <>{ui.eyebrow.split(" · ")[0]} · <span class="cd-device-names">{ui.eyebrow.split(" · ")[1]}</span></> : ui.eyebrow}</p>
					<h1 class="display-title cd-hero-title"><span>{ui.heroLine1}</span><span>{ui.heroLine2}</span></h1>
					<p class="cd-hero-description">
						{ui.heroDescription}
					</p>
					<div class="cd-hero-actions">
						<a class="button button-dark" href={storeURL} target="_blank" rel="noopener noreferrer">
							<svg width="20" height="20" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" /></svg>
							{ui.freeDownload}
						</a>
						<a class="hero-qr cd-hero-qr" href={storeURL} target="_blank" rel="noopener noreferrer" aria-label={ui.qrLabel}>
							<img src="/assets/clipdock-download-qr.png" width="62" height="62" alt={ui.qrAlt} />
							<span><strong>{ui.scan}</strong><small>{ui.getApp}</small></span>
						</a>
					</div>
					<p class="hero-proof" aria-label={ui.productInfo}>
						<span>{content.rating.score} ★ · {content.rating.count} {ui.ratings}</span>
						<span>{ui.privacyProof}</span>
					</p>
				</div>

				<HeroDemos locale={content.locale} />
			</div>
		</section>

		<div class="cd-capability-strip" aria-label={ui.capabilities}>
			<div class="cd-capability-track">
				{[0, 1].map(() => (
					<div class="cd-capability-group" aria-hidden="true">
						{capabilities.map((capability) => <span>{capability}</span>)}
					</div>
				))}
			</div>
		</div>

		<div id="features" class="cd-feature-list">
			{featureSections.map((feature) => (
				<section class="cd-feature-section">
					<div class="site-shell cd-feature-grid">
						<div class="cd-feature-copy" data-reveal>
							<div class="cd-feature-kicker"><strong>{feature.number}</strong><span>{feature.kicker}</span></div>
							<h2>{feature.title.split("\n").map((line, index) => content.locale === "en-US" ? <>{index > 0 && " "}<span class="cd-title-line">{line}</span></> : <>{index > 0 && <br />}<HeadingText text={line} locale={content.locale} /></>)}</h2>
							<p>{feature.description}</p>
							<ul>{feature.points.map((point, index) => (
								<li>
									{feature.platformDetails && index === 0 ? (
										<details class="cd-platform-details">
											<summary>{point}</summary>
											<p>{feature.platformDetails}</p>
										</details>
									) : <span>{point}</span>}
								</li>
							))}</ul>
							{feature.tutorial && tutorialLink(feature.tutorial) && (
								<a class="text-link cd-subtitle-link" href={tutorialLink(feature.tutorial)}>
									<span>{ui.subtitleLink}</span>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
										<path d="M7 17 17 7M7 7h10v10" />
									</svg>
								</a>
							)}
						</div>
						<div class:list={["cd-screenshot-stage", `is-${feature.tone}`, { "cd-feature-video-stage": Boolean(feature.video), "cd-feature-image-stage": Boolean(feature.carousel) }]} data-reveal>
							{feature.video ? (
								<>
								<video crossorigin="anonymous" class="cd-feature-video" src={mediaUrl(`/assets/demos/${feature.video}.mp4`)} poster={mediaUrl(`/assets/demos/${feature.video}.jpg`)} autoplay muted loop playsinline preload="metadata" disablepictureinpicture aria-label={`${feature.kicker}${ui.demoSuffix}`}></video>
								<progress class="cd-feature-progress" value="0" max="100" aria-label={ui.progress}></progress>
								<VideoRecovery locale={content.locale} />
								<p class="cd-feature-caption" data-fallback={feature.kicker} aria-live="off">{captionAt(`/assets/demos/${feature.video}.mp4`, 0, feature.kicker, content.locale)}</p>
								</>
							) : feature.carousel ? (
								<SubtitleCarousel locale={content.locale} />
							) : (<>
							<div class="cd-stage-label">{commonCopy[content.locale].screenPlaceholder} / {feature.number}</div>
							<div class="cd-phone-placeholder">
								<span class="cd-phone-speaker"></span>
								<div class="cd-placeholder-copy">
									<strong>{feature.placeholder}</strong>
									<span>{ui.placeholder}</span>
								</div>
							</div>
							</>)}
						</div>
					</div>
				</section>
			))}
		</div>

		<section id="use-cases" class="cd-section cd-tools">
			<div class="site-shell">
				<div class="cd-section-heading">
					<div>
						<p class="section-kicker">{ui.toolsKicker}</p>
						<h2 class="section-title"><HeadingText text={ui.toolsTitle} locale={content.locale} /></h2>
					</div>
					<p class="section-lede">{ui.toolsDescription}</p>
				</div>
				<div class="cd-tool-grid">
					{tools.map((tool) => {
                        const href = tutorialLink(tool.slug);
                        const Card = href ? "a" : "article";
                        return (
						<Card class="cd-tool-card" href={href} aria-label={href ? `${tool.title}: ${ui.readTutorial}` : undefined} data-reveal>
							<span>{tool.mark}</span>
							<h3><HeadingText text={tool.title} locale={content.locale} /></h3>
							<p>{tool.description}</p>
						</Card>
					); })}
				</div>
			</div>
		</section>

		<section class="cd-section">
			<div class="site-shell cd-trust-panel" data-reveal>
				<div class="cd-trust-heading">
					<div>
						<p class="section-kicker">{ui.trustKicker}</p>
						<h2 class="section-title"><HeadingText text={ui.trustTitle} locale={content.locale} /></h2>
					</div>
					<p class="section-lede">{ui.trustDescription}</p>
				</div>
				<div class="cd-trust-grid">
					<article><strong>{ui.trustValue1}</strong><h3>{ui.trustLabel1}</h3><p>{ui.trustText1}</p></article>
					<article><strong>iOS 15+</strong><h3>{ui.trustLabel2}</h3><p>{ui.trustText2}</p></article>
					<article><strong>{ui.trustValue3}</strong><h3>{ui.trustLabel3}</h3><p>{ui.trustText3}</p></article>
				</div>
			</div>
		</section>

		<section id="faq" class="cd-section cd-faq">
			<div class="site-shell">
				<p class="section-kicker">{ui.faqKicker}</p>
				<h2 class="section-title"><HeadingText text={ui.faqTitle} locale={content.locale} /></h2>
				<div class="cd-faq-list">
					{faqs.map((item) => (
						<details class="cd-faq-item">
							<summary>{item.question}</summary>
							<div>{item.answer}</div>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="cd-section cd-closing">
			<div class="site-shell cd-closing-panel" data-reveal>
				<div class="cd-closing-copy">
					<p class="eyebrow">{ui.closingKicker}</p>
					<h2 class="section-title"><HeadingText text={ui.closingTitle} locale={content.locale} /></h2>
					<p class="section-lede">{ui.closingDescription}</p>
					<a class="button button-dark" href={storeURL} target="_blank" rel="noopener noreferrer">{ui.storeDownload}</a>
				</div>
				<div class="cd-download-qr">
					<img src="/assets/clipdock-download-qr.png" alt={ui.closingQr} width="400" height="400" loading="lazy" decoding="async" />
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { setupVideoRecovery } from "@/lib/videoRecoveryUI";
	import { captionAt } from "@config/demoCaptions";

	// Fit complete English phrases only when the normal responsive size exceeds the column.
	if (document.documentElement.lang === "en") {
		const titles = [...document.querySelectorAll<HTMLElement>(".cd-hero-title, .cd-feature-copy h2, .cd-trust-grid strong")];
		const fitTitles = () => {
			const minimumSize = parseFloat(getComputedStyle(document.documentElement).fontSize) * 2;
			for (const title of titles) {
				title.style.removeProperty("--fitted-title-size");
				const availableWidth = title.getBoundingClientRect().width;
				if (!availableWidth) continue;
				const normalSize = parseFloat(getComputedStyle(title).fontSize);
				const probe = title.cloneNode(true) as HTMLElement;
				probe.setAttribute("aria-hidden", "true");
				probe.style.cssText = `position:fixed;visibility:hidden;pointer-events:none;width:max-content;max-width:none;font-size:${normalSize}px;`;
				probe.querySelectorAll<HTMLElement>("span").forEach((line) => {
					line.style.cssText = "display:block;white-space:nowrap;";
				});
				title.parentElement!.append(probe);
				const phraseWidth = probe.getBoundingClientRect().width;
				probe.remove();
				if (phraseWidth > availableWidth) {
					const fittedSize = Math.max(Math.min(minimumSize, normalSize), normalSize * (availableWidth - 1) / phraseWidth);
					title.style.setProperty("--fitted-title-size", `${fittedSize}px`);
				}
			}
			// These three peer cards share the smallest size required by any title.
			const trustTitles = titles.filter((title) => title.matches(".cd-trust-grid strong"));
			if (trustTitles.length) {
				const sharedSize = Math.min(...trustTitles.map((title) => parseFloat(getComputedStyle(title).fontSize)));
				trustTitles.forEach((title) => title.style.setProperty("--fitted-title-size", `${sharedSize}px`));
			}
		};
		let frame = 0;
		const scheduleFit = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(fitTitles);
		};
		const widths = new WeakMap<Element, number>();
		const observer = new ResizeObserver((entries) => {
			if (entries.some(({ target, contentRect }) => {
				const previous = widths.get(target);
				widths.set(target, contentRect.width);
				return previous !== contentRect.width;
			})) scheduleFit();
		});
		titles.forEach((title) => observer.observe(title));
		window.addEventListener("resize", scheduleFit);
		document.fonts.ready.then(scheduleFit);
		document.fonts.addEventListener("loadingdone", scheduleFit);
		fitTitles();
	}

	document.querySelectorAll<HTMLElement>(".cd-feature-video-stage").forEach((stage) => {
		const video = stage.querySelector<HTMLVideoElement>("video")!;
		setupVideoRecovery(stage, video);
		const progress = stage.querySelector<HTMLProgressElement>("progress")!;
		const caption = stage.querySelector<HTMLElement>(".cd-feature-caption")!;
		const src = video.getAttribute("src")!;
		const update = () => {
			progress.value = Number.isFinite(video.duration) && video.duration > 0
				? Math.min(100, Math.max(0, video.currentTime / video.duration * 100)) : 0;
			const text = captionAt(src, video.currentTime, caption.dataset.fallback!, document.documentElement.lang);
			if (caption.textContent !== text) caption.textContent = text;
		};
		["timeupdate", "loadedmetadata", "durationchange", "emptied", "seeking", "seeked"].forEach((event) => video.addEventListener(event, update));
		update();
	});
</script>

<style>
	.clipdock-main { overflow: clip; }
	.cd-hero { min-height: calc(100vh - 84px); padding: clamp(72px, 10vh, 118px) 0 78px; }
	.cd-hero-grid { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(390px, .8fr); align-items: center; gap: clamp(44px, 7vw, 96px); }
	.cd-hero-copy { container-type: inline-size; }
	.cd-hero-title { max-width: none; font-size: clamp(2.9rem, 5.1vw, 5.1rem); line-height: 1.16; }
	.cd-hero-title span { display: block; white-space: nowrap; }
	.cd-device-names { text-transform: none; }
	:global(html[lang="en"]) .cd-hero-copy,
	:global(html[lang="en"]) .cd-feature-copy { container-type: inline-size; min-width: 0; }
	:global(html[lang="en"]) .cd-hero-title { font-size: var(--fitted-title-size, clamp(2.9rem, 5.1vw, 5.1rem)); }
	:global(html[lang="en"]) .cd-hero-title span { white-space: normal; text-wrap: balance; }
	.cd-hero-description { max-width: 650px; margin: 1.7rem 0 0; color: var(--ink-soft); font-size: clamp(1.08rem, 1.8vw, 1.35rem); line-height: 1.65; }
	.cd-hero-actions { display: flex; flex-wrap: wrap; align-items: stretch; gap: 12px; margin-top: 2rem; }
	.cd-hero-actions > a { flex: 0 1 220px; width: 220px; max-width: 100%; min-width: 0; min-height: 80px; }
	.cd-hero-actions .button { font-size: 1rem; }
	.cd-hero-qr { margin-top: 0; }
	.cd-hero-qr img { flex-shrink: 0; }
	.cd-hero-media { position: relative; min-height: 610px; border: 2px solid var(--ink); border-radius: var(--radius-lg); background: var(--blue); box-shadow: 14px 14px 0 var(--ink); padding: 20px; }
	.cd-media-label { position: absolute; top: -19px; left: 28px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--lime); padding: .55rem .8rem; font-family: var(--mono); font-size: .68rem; font-weight: 900; letter-spacing: .08em; }
	.cd-media-placeholder { display: grid; place-items: center; align-content: center; min-height: 515px; border: 2px dashed rgba(23,25,22,.48); border-radius: 24px; background: rgba(255,253,247,.82); text-align: center; }
	.cd-media-placeholder strong { margin-top: 18px; font-family: var(--display); font-size: 1.55rem; letter-spacing: -.04em; }
	.cd-media-placeholder span { margin-top: 7px; color: var(--ink-soft); font-size: .86rem; }
	.cd-play { display: grid; place-items: center; width: 76px; height: 76px; border: 2px solid var(--ink); border-radius: 50%; background: var(--lime); padding-left: 5px; font-size: 1.25rem; }
	.cd-media-footer { display: flex; justify-content: space-between; gap: 12px; padding: 17px 4px 0; font-family: var(--mono); font-size: .64rem; font-weight: 850; letter-spacing: .06em; }
	.cd-capability-strip { overflow: hidden; border-block: 1.5px solid var(--ink); background: var(--ink); color: var(--paper-strong); }
	.cd-capability-track { display: flex; width: max-content; animation: cd-marquee 110s linear infinite; }
	.cd-capability-group { display: flex; align-items: center; gap: 24px; padding: 17px 12px; font-family: var(--mono); font-size: .71rem; font-weight: 850; letter-spacing: .08em; white-space: nowrap; }
	.cd-capability-group strong { color: var(--blue); }
	.cd-capability-group span::after { margin-left: 24px; color: var(--lime); content: "✦"; }
	@keyframes cd-marquee { to { transform: translateX(-50%); } }
	.cd-section { padding: clamp(90px, 12vw, 162px) 0; }
	.cd-section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .64fr); align-items: end; gap: 44px; margin-bottom: 54px; }
	.cd-section-heading .section-lede { margin: 0; }
	.cd-step-grid { display: grid; grid-template-columns: repeat(3, 1fr); overflow: hidden; border: 1.5px solid var(--ink); border-radius: var(--radius-md); background: var(--paper-strong); }
	.cd-step-card { position: relative; display: flex; flex-direction: column; min-height: 330px; padding: 28px; border-right: 1.5px solid var(--ink); }
	.cd-step-card:last-child { border-right: 0; }
	.cd-step-card::after { position: absolute; top: 25px; right: 27px; content: "↘"; font-size: 1.35rem; }
	.cd-step-number { width: fit-content; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--blue); padding: .5rem .65rem; font-family: var(--mono); font-size: .68rem; font-weight: 900; }
	.cd-step-card:nth-child(2) .cd-step-number { background: var(--lime); }
	.cd-step-card:nth-child(3) .cd-step-number { background: #ffc9bd; }
	.cd-step-card h3 { margin: auto 0 .8rem; font-family: var(--display); font-size: clamp(1.8rem, 2.7vw, 2.5rem); letter-spacing: -.055em; line-height: 1; }
	.cd-step-card p { margin: 0; color: var(--ink-soft); line-height: 1.6; }
	.cd-feature-section { padding: clamp(78px, 10vw, 132px) 0; border-top: 1.5px solid var(--line-strong); }
	.cd-feature-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(420px, 1fr); align-items: center; gap: clamp(54px, 8vw, 112px); }
	.cd-feature-section:nth-child(even) .cd-feature-copy { order: 2; }
	.cd-feature-section:nth-child(even) .cd-screenshot-stage { order: 1; }
	.cd-feature-kicker { display: flex; align-items: center; gap: 12px; margin-bottom: 1.35rem; color: var(--ink-soft); font-family: var(--mono); font-size: .72rem; font-weight: 900; letter-spacing: .08em; }
	.cd-feature-kicker strong { display: grid; place-items: center; width: 44px; height: 44px; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--blue); color: var(--ink); }
	.cd-feature-copy h2 { max-width: 100%; margin: 0; font-family: var(--display); font-size: clamp(2.9rem, 5.1vw, 5.1rem); letter-spacing: -.07em; line-height: .94; text-wrap: wrap; }
	:global(html[lang="en"]) .cd-feature-copy h2 { font-size: var(--fitted-title-size, clamp(2.9rem, 5.1vw, 5.1rem)); line-height: 1.08; text-wrap: balance; }
	.cd-title-line { display: block; }
	:global(html:is([lang="zh-Hans"], [lang="zh-Hant"])) .cd-feature-copy h2 { line-height: 1.18; text-wrap: balance; }
	:global(html:is([lang="zh-Hans"], [lang="zh-Hant"])) .section-title { line-height: 1.2; }
	:global(html:is([lang="zh-Hans"], [lang="zh-Hant"])) .cd-tool-card h3 { line-height: 1.3; }
	:global(html[lang="ja"]) .cd-hero-title { font-size: clamp(2.5rem, 7.8cqw, 4.5rem); line-height: 1.3; letter-spacing: -.035em; }
	:global(html[lang="ja"]) .cd-hero-title span { white-space: normal; text-wrap: balance; }
	:global(html[lang="ja"]) .cd-feature-copy h2 { font-size: clamp(2.3rem, 4.1vw, 4rem); line-height: 1.35; letter-spacing: -.035em; text-wrap: balance; }
	:global(html[lang="ja"]) .section-title { max-width: none; font-size: clamp(2.3rem, 4.1vw, 4rem); line-height: 1.35; letter-spacing: -.035em; text-wrap: balance; }
	:global(html[lang="ja"]) .cd-closing-copy .section-title { max-width: none; }
	:global(html[lang="ja"]) .cd-tool-card h3 { line-height: 1.45; letter-spacing: -.02em; text-wrap: balance; }
	:global(html[lang="ja"]) .cd-trust-grid strong { line-height: 1.3; }
	/* Spanish and Brazilian Portuguese titles wrap at spaces, including the two independent hero phrases. */
	:global(html:is([lang="es"], [lang="pt-BR"])) .cd-hero-title { font-size: clamp(2.4rem, 8.5cqw, 4.6rem); line-height: 1.12; }
	:global(html:is([lang="es"], [lang="pt-BR"])) .cd-hero-title span { white-space: normal; text-wrap: balance; }
	:global(html:is([lang="es"], [lang="pt-BR"])) :is(.cd-feature-copy h2, .section-title) { max-width: none; font-size: clamp(2.25rem, 4vw, 4rem); line-height: 1.15; text-wrap: balance; }
	:global(html:is([lang="es"], [lang="pt-BR"])) .cd-tool-card h3 { line-height: 1.3; text-wrap: balance; }
	:global(html:is([lang="es"], [lang="pt-BR"])) .cd-feature-kicker strong { flex-shrink: 0; }
