---
import TutorialArticle from "@layouts/TutorialArticle.astro";
import { getTutorials } from "@/content/localized-tutorials";
export function getStaticPaths() {
 return getTutorials("en-US").map(article => ({ params: { slug: article.slug }, props: { article } }));
}
---
<TutorialArticle article={Astro.props.article} locale="en-US" />
