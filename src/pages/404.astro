---
import { notFound } from "@/i18n/en-US/errors";
import { notFound as traditionalNotFound } from "@/i18n/zh-Hant/errors";
import { notFound as chineseNotFound } from "@/i18n/zh-Hans/errors";
import { siteConfig } from "@config/site";
import Layout from "@layouts/Layout.astro";
import { landingContent } from "@/i18n/content";
import { getLanguageLinks } from "@/i18n/locales";
---

<Layout
	title={`${notFound.title} | ${siteConfig.name}`}
	description={notFound.description}
	noindex
	lang="en"
	appData={landingContent["en-US"]}
	alternates={getLanguageLinks("en-US")}
	homeHref="/"
>
	<main id="main-content" class="detail-main">
		<div class="site-shell" style="min-height: 68vh; display: grid; place-items: center;">
			<div style="max-width: 760px; width: 100%; min-width: 0; text-align: center;">
				<p class="eyebrow" style="margin-inline: auto;">{notFound.eyebrow}</p>
				<h1 class="display-title" style="font-size: clamp(2.5rem, 8vw, 5rem);">{notFound.heading}</h1>
				<p class="section-lede" style="margin-inline: auto;">
					{notFound.body}
				</p>
				<a class="button button-dark" href="/" style="margin-top: 2rem;">{notFound.home}</a>
                <p lang="zh-Hans"><a href="/zh-Hans/">{chineseNotFound.languageHome}</a></p>
                <p lang="zh-Hant"><a href="/zh-Hant/">{traditionalNotFound.languageHome}</a></p>
			</div>
		</div>
	</main>
</Layout>
