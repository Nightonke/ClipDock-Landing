---
import { siteConfig } from "@config/site";
import Layout from "@layouts/Layout.astro";
import { landingContent } from "@/i18n/content";
import { getLanguageLinks } from "@/i18n/locales";
---

<Layout
	title={`404 - Page Not Found | ${siteConfig.name}`}
	description="This page does not exist. Return to ClipDock to explore video extraction, downloads, organization, and processing tools."
	noindex
	lang="en"
	appData={landingContent["en-US"]}
	alternates={getLanguageLinks("en-US")}
	homeHref="/"
>
	<main id="main-content" class="detail-main">
		<div class="site-shell" style="min-height: 68vh; display: grid; place-items: center;">
			<div style="max-width: 760px; width: 100%; min-width: 0; text-align: center;">
				<p class="eyebrow" style="margin-inline: auto;">Error / 404</p>
				<h1 class="display-title" style="font-size: clamp(2.5rem, 8vw, 5rem);">Page not found</h1>
				<p class="section-lede" style="margin-inline: auto;">
					This page may have moved. Return to ClipDock for video downloads, captions, and video tools.
				</p>
				<a class="button button-dark" href="/" style="margin-top: 2rem;">Back to home</a>
                <p lang="zh-Hans"><a href="/zh-Hans/">返回简体中文首页</a></p>
			</div>
		</div>
	</main>
</Layout>
