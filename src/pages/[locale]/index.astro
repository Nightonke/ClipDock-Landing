---
import LandingPage from "@layouts/LandingPage.astro";
import ClipDockZhLanding from "@layouts/ClipDockZhLanding.astro";
import { landingContent } from "@/i18n/content";
import { defaultLocale, getLanguageLinks, publishedLocales, type Locale } from "@/i18n/locales";

export function getStaticPaths() {
	return publishedLocales
		.filter((locale) => locale !== defaultLocale)
		.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const content = landingContent[locale];
const languageLinks = getLanguageLinks(locale);
---

{
	locale === "zh-Hans" ? (
		<ClipDockZhLanding content={content} languageLinks={languageLinks} />
	) : (
		<LandingPage content={content} languageLinks={languageLinks} />
	)
}
