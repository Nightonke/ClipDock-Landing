---
import LegalPage from "@layouts/LegalPage.astro";
import { defaultLocale, publishedLocales, type Locale } from "@/i18n/locales";
export function getStaticPaths() {
  return publishedLocales.filter(locale => locale !== defaultLocale).map(locale => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
---
<LegalPage locale={locale} page="terms" />
